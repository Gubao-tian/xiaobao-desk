.nav {
  position: fixed;
  left: 0; top: 0; bottom: 0;
  width: 440rpx;
  padding: 40rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(18rpx);
  border-right: 2rpx solid var(--line);
  z-index: 120;
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(0.22, 0.85, 0.3, 1);
  box-shadow: 8rpx 0 40rpx rgba(242, 104, 154, 0.14);
}
.nav.open { transform: none; }

.brand { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 10rpx 28rpx; }
.brand-mark {
  width: 76rpx; height: 76rpx; border-radius: 26rpx; flex: 0 0 76rpx;
  background: linear-gradient(145deg, #FFB6D2, #F2689A);
  display: flex; align-items: center; justify-content: center; font-size: 38rpx;
  box-shadow: 0 8rpx 20rpx rgba(242, 104, 154, 0.32);
}
.brand-txt { display: flex; flex-direction: column; }
.bt { font-size: 28rpx; font-weight: 800; }
.bs { font-size: 17rpx; color: var(--text-3); letter-spacing: 2rpx; }

.nav-list { flex: 1; overflow: hidden; }
.nav-foot {
  margin-top: 16rpx; padding-top: 18rpx; border-top: 2rpx solid var(--line-2);
  font-size: 19rpx; color: var(--text-3); letter-spacing: 1rpx; text-align: center;
}
.nav-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 18rpx 18rpx; margin-bottom: 8rpx;
  border-radius: 24rpx; color: var(--text-2);
  font-size: 27rpx; font-weight: 500;
  position: relative;
}
.nav-item.on {
  background: linear-gradient(100deg, #FFE3EF, #FFF0F7);
  color: var(--pink-deep); font-weight: 700;
  box-shadow: inset 0 0 0 3rpx var(--pink-soft);
}
.nav-item.on::before {
  content: ""; position: absolute; left: -24rpx; top: 50%; transform: translateY(-50%);
  width: 8rpx; height: 34rpx; border-radius: 0 10rpx 10rpx 0;
  background: linear-gradient(180deg, #FFA9C9, #F2689A);
}
.nav-ico {
  width: 56rpx; height: 56rpx; flex: 0 0 56rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--pink-pale); font-size: 30rpx;
}
.nav-item.on .nav-ico { background: #fff; }
.nav-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-badge {
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 16rpx;
  background: var(--pink); color: #fff; font-size: 19rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}

.nav-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; inset: 0; background: rgba(92, 68, 80, 0.28);
  z-index: 110; opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.nav-mask.on { opacity: 1; pointer-events: auto; }

/* 左上角导航按钮：轻量卡片风，与页面融合；抽屉打开时淡出隐藏 */
.nav-fab {
  position: fixed; left: 24rpx; top: calc(24rpx + env(safe-area-inset-top));
  width: 76rpx; height: 76rpx; border-radius: 24rpx; z-index: 130;
  background: var(--card, #fff); color: var(--text-2, #A08A93);
  border: 1.5rpx solid var(--line, #F6DCE7);
  box-shadow: 0 6rpx 16rpx rgba(242, 104, 154, 0.12);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; line-height: 1;
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.nav-fab:active { transform: scale(0.94); }
.nav-fab.hide { opacity: 0; transform: scale(0.82); pointer-events: none; }

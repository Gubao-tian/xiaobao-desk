.tl-head { padding: 24rpx 8rpx 26rpx; }
.tl-title { font-size: 40rpx; font-weight: 800; color: #2b2330; }
.tl-sub { font-size: 25rpx; color: #8a8290; margin-top: 8rpx; }
.nav-btn {
  width: 68rpx; height: 68rpx; border-radius: 22rpx;
  background: var(--pink-pale); color: var(--pink-deep);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 800;
}
.nav-btn.off { opacity: .35; }
.day-pick {
  font-size: 30rpx; font-weight: 800; color: var(--text-1);
  background: var(--card-soft); padding: 14rpx 24rpx; border-radius: 18rpx;
}
.tl { position: relative; padding-left: 8rpx; }
.tl-item {
  display: flex; align-items: flex-start; gap: 18rpx;
  padding: 20rpx 0; border-bottom: 2rpx dashed #f0e6ec;
}
.tl-item:last-child { border-bottom: none; }
.tl-ico {
  width: 60rpx; height: 60rpx; flex: 0 0 60rpx; border-radius: 20rpx;
  background: var(--card-soft); display: flex; align-items: center; justify-content: center; font-size: 30rpx;
}
.tl-body { flex: 1; min-width: 0; }
.tl-t { font-size: 27rpx; font-weight: 700; color: var(--text-1); }
.tl-s { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.tl-empty { text-align: center; padding: 50rpx 0; color: var(--text-3); font-size: 25rpx; }
.tl-empty .emo { display: block; font-size: 60rpx; margin-bottom: 14rpx; }

<side-nav active="timeline" bind:navigate="onNav" />

<view class="page" style="{{pageStyle}}">
  <view class="tl-head">
    <view class="tl-title">🗓️ 日历时间轴</view>
    <view class="tl-sub">一天里所有模块的记录，都按时间排好</view>
  </view>

  <!-- 日期选择 -->
  <view class="card">
    <view class="row between">
      <view class="row" style="gap:18rpx">
        <view class="nav-btn" bindtap="onPrev">‹</view>
        <picker mode="date" value="{{day}}" bindchange="onPickDay">
          <view class="day-pick">{{dayLabel}} · {{weekLabel}}</view>
        </picker>
        <view class="nav-btn{{canNext ? '' : ' off'}}" bindtap="onNext">›</view>
      </view>
      <button class="btn ghost sm" wx:if="{{!isToday}}" bindtap="onToday">回到今天</button>
      <text class="pill mint" wx:else>今天</text>
    </view>
    <view class="grid4" style="margin-top:22rpx">
      <view class="stat" wx:for="{{summary}}" wx:key="index">
        <view class="val" style="font-size:30rpx">{{item.v}}</view>
        <view class="lbl">{{item.l}}</view>
      </view>
    </view>
  </view>

  <!-- 时间轴 -->
  <view class="card">
    <view class="sec-title"><view class="dot"></view>这一天的记录</view>
    <block wx:if="{{nodes.length}}">
      <view class="tl">
        <view class="tl-item" wx:for="{{nodes}}" wx:key="index">
          <view class="tl-ico">{{item.icon}}</view>
          <view class="tl-body">
            <view class="tl-t">{{item.title}}</view>
            <view class="tl-s" wx:if="{{item.sub}}">{{item.sub}}</view>
          </view>
          <view class="pill" wx:if="{{item.tag}}">{{item.tag}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="tl-empty">
      <text class="emo">🫧</text>
      <text>这一天还没有记录，去各模块添加吧～</text>
    </view>
  </view>
</view>

.sheet-title { font-size: 32rpx; font-weight: 800; text-align: center; margin-bottom: 24rpx; }
.fl { display: block; font-size: 22rpx; font-weight: 700; color: var(--text-2); margin-bottom: 8rpx; }

/* 课程列表 */
.citem { padding: 22rpx 0; border-bottom: 2rpx solid var(--line-2); }
.citem:last-child { border-bottom: none; padding-bottom: 0; }
.cname { font-size: 28rpx; font-weight: 800; }
.cprog-n { font-size: 24rpx; font-weight: 800; color: var(--pink-deep); }
.cdel { color: var(--pink-deep); }

/* 颜色圆点 */
.cdot {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx var(--line);
}
.cdot.on { box-shadow: 0 0 0 5rpx var(--pink-deep); }

/* 近 7 天柱状图 */
.chart { display: flex; align-items: flex-end; gap: 10rpx; height: 240rpx; padding-top: 20rpx; }
.cbar {
  flex: 1; display: flex; align-items: flex-start; justify-content: center;
  border-radius: 12rpx 12rpx 6rpx 6rpx; min-height: 8rpx; position: relative;
}
.cv { font-size: 18rpx; color: #fff; font-weight: 700; margin-top: 6rpx; }
.crow { display: flex; gap: 10rpx; margin-top: 10rpx; }
.cw { flex: 1; text-align: center; font-size: 19rpx; color: var(--text-3); font-weight: 700; }
.cw.td { color: var(--pink-deep); }

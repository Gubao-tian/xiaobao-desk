.page { padding: 28rpx 28rpx 120rpx; }
.remind-head { padding: 20rpx 8rpx 26rpx; }
.rh-title { font-size: 40rpx; font-weight: 800; color: #2b2330; }
.rh-sub { font-size: 26rpx; color: #8a8290; margin-top: 8rpx; }
.card { background: #fff; border-radius: 26rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 8rpx 24rpx rgba(242,104,154,0.08); }
.r-name { font-size: 30rpx; font-weight: 700; color: #2b2330; }
.r-body { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx dashed #f0e6ec; }
.picker-val { margin-top: 14rpx; display: inline-block; background: #FFF4F8; color: #F2689A; font-weight: 700; font-size: 28rpx; padding: 14rpx 26rpx; border-radius: 16rpx; }
.sub-card { border: 2rpx solid #FFE3EF; }
.sub-state { font-size: 26rpx; color: #8a8290; }
.warn { color: #E5836B; }
.mt8 { margin-top: 16rpx; }
.center { text-align: center; }

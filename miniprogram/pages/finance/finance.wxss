.sheet-title { font-size: 32rpx; font-weight: 800; text-align: center; margin-bottom: 24rpx; }
.fl { display: block; font-size: 22rpx; font-weight: 700; color: var(--text-2); margin-bottom: 8rpx; }

/* 收入绿 / 支出粉 */
.in-amt { color: #3FA98A; font-weight: 800; }
.out-amt { color: var(--pink-deep); font-weight: 800; }
.big-num { font-size: 44rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1.2; }

/* 绿色收入按钮 */
.btn.green {
  background: linear-gradient(135deg, #B7EBD9, #5FC9A8);
  color: #fff; box-shadow: 0 8rpx 20rpx rgba(95, 201, 168, 0.28);
}

/* 明细列表 */
.fitem {
  display: flex; align-items: center; gap: 18rpx;
  padding: 20rpx 0; border-bottom: 2rpx solid var(--line-2);
}
.fitem:last-child { border-bottom: none; padding-bottom: 0; }
.fcat { font-size: 27rpx; font-weight: 700; }
.famt { font-size: 29rpx; }
.fdel { color: var(--pink-deep); flex: 0 0 auto; }
.avatar.income { background: linear-gradient(135deg, #B7EBD9, #5FC9A8); }
.avatar.expense { background: linear-gradient(135deg, #FFA6C8, #F2689A); }

/* 分类占比 */
.catname { font-size: 26rpx; font-weight: 700; }

/* 储蓄目标 */
.goal-card {
  background: var(--card-soft); border: 2rpx solid var(--line-2);
  border-radius: var(--r); padding: 20rpx;
}
.gname { font-size: 26rpx; font-weight: 800; }
.gdel { color: var(--pink-deep); }

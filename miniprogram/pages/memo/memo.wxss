/* 弹层补充样式（app.wxss 未定义部分，按规范补齐） */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; inset: 0; background: rgba(92, 68, 80, 0.32); z-index: 200; display: flex; align-items: flex-end; }
.sheet-title { font-size: 32rpx; font-weight: 800; text-align: center; margin-bottom: 24rpx; }
.fl { display: block; font-size: 22rpx; font-weight: 700; color: var(--text-2); margin-bottom: 8rpx; }

.ta {
  font-family: inherit; font-size: 26rpx; color: var(--text); line-height: 1.6;
  border: 2rpx solid var(--line); border-radius: 26rpx;
  padding: 18rpx 24rpx; background: var(--card-soft);
  width: 100%; min-height: 200rpx;
}

/* 颜色 tabs */
.tab {
  padding: 10rpx 26rpx; border-radius: 30rpx;
  background: var(--card-soft); color: var(--text-2);
  font-size: 24rpx; font-weight: 700;
  border: 2rpx solid var(--line-2);
}
.tab.on {
  background: linear-gradient(135deg, #FFA6C8, #F2689A); color: #fff;
  border-color: transparent; box-shadow: 0 6rpx 16rpx rgba(242, 104, 154, 0.28);
}

/* 便签网格：grid2 语义 + flex wrap（Masonry 效果） */
.mgrid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mgrid > view { width: calc(50% - 8rpx); }

.note {
  border: 2rpx solid var(--line-2); border-radius: var(--r-lg);
  padding: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(242, 104, 154, 0.08);
}
.ntitle { font-size: 27rpx; font-weight: 800; word-break: break-all; }
.nbody { font-size: 24rpx; line-height: 1.6; color: var(--text-2); margin-top: 10rpx; word-break: break-all; white-space: pre-wrap; }

.del-ico {
  width: 40rpx; height: 40rpx; flex: 0 0 40rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255, 255, 255, 0.7); color: var(--text-2);
  font-size: 20rpx; font-weight: 700;
}
.nbtn { font-size: 24rpx; font-weight: 700; color: var(--pink-deep); }

/* 颜色选择圆点 */
.dotc {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 4rpx solid var(--line);
}
.dotc.on { border-color: var(--pink-deep); box-shadow: 0 0 0 6rpx var(--pink-pale); }

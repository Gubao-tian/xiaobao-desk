<side-nav active="memo" bind:navigate="onNav" />

<view class="page" style="{{pageStyle}}">
  <!-- 工具栏：搜索 + 颜色 tabs + 新建 -->
  <view class="card">
    <view class="row" style="gap:12rpx">
      <input class="inp" value="{{form.search}}" placeholder="搜索标题或内容" bindinput="onSearchInput" bindblur="onSearchInputBlur" />
      <button class="btn primary" bindtap="onNew">+ 新建便签</button>
    </view>
    <view class="row wrap mt" style="gap:12rpx">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        class="tab {{tab === item.v ? 'on' : ''}}"
        data-v="{{item.v}}"
        bindtap="onTab"
      >{{item.t}}</view>
    </view>
  </view>

  <!-- 便签网格（置顶在前，其余按创建时间倒序） -->
  <block wx:if="{{memos.length}}">
    <view class="mgrid">
      <view
        wx:for="{{memos}}"
        wx:key="id"
        class="note"
        style="background:{{item.bg}};border-color:{{item.bd}}"
      >
        <view class="row between">
          <view class="ntitle grow">{{item.pin ? '📌 ' : ''}}{{item.title}}</view>
          <view class="del-ico" data-id="{{item.id}}" bindtap="onDel">✕</view>
        </view>
        <view class="nbody">{{item.body}}</view>
        <view class="tiny mt8">{{item.createdText}}</view>
        <view class="row mt12" style="gap:20rpx">
          <text class="nbtn" data-id="{{item.id}}" bindtap="onTogglePin">{{item.pin ? '取消置顶' : '置顶'}}</text>
          <text class="nbtn" data-id="{{item.id}}" bindtap="onEdit">编辑</text>
        </view>
      </view>
    </view>
  </block>
  <view wx:else class="empty">{{emptyText}}</view>
</view>

<!-- 新建 / 编辑弹层 -->
<view class="mask" wx:if="{{showModal}}" bindtap="onMaskTap" data-key="showModal">
  <view class="sheet" catchtap="">
    <view class="sheet-title">{{modalTitle}}</view>
    <form bindsubmit="submitModal" report-submit>
      <view class="field"><text class="fl">标题</text><input class="inp" name="title" value="{{form.title}}" placeholder="便签标题" bindinput="onFormTitle" bindblur="onFormTitleBlur" /></view>
      <view class="field"><text class="fl">内容</text><textarea class="ta" name="body" value="{{form.body}}" placeholder="写点什么…" bindinput="onFormBody" bindblur="onFormBodyBlur"></textarea></view>
      <view class="field">
        <text class="fl">颜色</text>
        <view class="row" style="gap:16rpx">
          <view
            wx:for="{{colors}}"
            wx:key="*this"
            class="dotc {{form.color === item.v ? 'on' : ''}}"
            style="background:{{item.bg}};border-color:{{item.bd}}"
            data-v="{{item.v}}"
            bindtap="onPickColor"
          ></view>
        </view>
      </view>
      <view class="row" style="gap:16rpx;margin-top:24rpx">
        <button class="btn ghost" style="flex:1" bindtap="closeModal">取消</button>
        <button class="btn primary" style="flex:1" form-type="submit">保存</button>
      </view>
    </form>
  </view>
</view>

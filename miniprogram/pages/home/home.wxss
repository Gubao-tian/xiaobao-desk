.hero { display: flex; flex-direction: column; gap: 20rpx; }

.clock-card {
  position: relative; overflow: hidden;
  background: linear-gradient(140deg, #FFF0F7, #FFE0EE 45%, #F4E8FF);
  border: 2rpx solid #FFDDEB;
  border-radius: 32rpx; padding: 34rpx;
  box-shadow: 0 8rpx 28rpx rgba(242, 104, 154, 0.12);
}
.clock-time {
  font-size: 72rpx; font-weight: 800; letter-spacing: -2rpx; line-height: 1.05;
  font-variant-numeric: tabular-nums;
  background: linear-gradient(120deg, #F2689A, #B97BE8);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.clock-date { font-size: 25rpx; color: var(--text-2); font-weight: 600; margin-top: 10rpx; }
.clock-greet { font-size: 24rpx; color: var(--pink-deep); font-weight: 700; margin-top: 4rpx; }

.quote-card { background: linear-gradient(150deg, #FFFFFF, #FFF7FB 60%, #FCF1FF); }
.quote-cn { font-size: 33rpx; font-weight: 800; line-height: 1.6; }
.quote-en { font-size: 24rpx; color: var(--text-2); line-height: 1.55; margin-top: 14rpx; font-style: italic; }

.pct { font-size: 29rpx; font-weight: 800; color: var(--pink-deep); }

.checkin-row { display: flex; align-items: center; gap: 26rpx; }
.ring {
  width: 170rpx; height: 170rpx; flex: 0 0 170rpx; border-radius: 50%;
  background: conic-gradient(#F2689A {{checked ? 100 : 0}}%, var(--pink-pale) 0);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.6s ease;
}
.ring-core {
  width: 138rpx; height: 138rpx; border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx;
}
.ring-b { font-size: 40rpx; font-weight: 800; line-height: 1.1; }
.ring-s { font-size: 19rpx; color: var(--text-3); font-weight: 700; }

.big-check {
  width: 100%; padding: 26rpx; border-radius: 30rpx; border: none;
  font-size: 29rpx; font-weight: 800; line-height: 1;
  background: linear-gradient(135deg, #FFA6C8, #F2689A); color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(242, 104, 154, 0.3);
}
.big-check::after { border: none; }
.big-check.done { background: linear-gradient(135deg, #B7EBD9, #5FC9A8); box-shadow: 0 10rpx 24rpx rgba(95, 201, 168, 0.26); }

.flame { font-size: 25rpx; font-weight: 800; color: #F2689A; }

.wk-row { display: flex; gap: 8rpx; flex-wrap: wrap; }
.wk {
  width: calc((100% - 112rpx) / 15); height: 44rpx; border-radius: 12rpx;
  background: var(--card-soft); display: flex; align-items: center; justify-content: center;
  font-size: 19rpx; color: var(--text-3); font-weight: 700;
}
.wk.on { background: linear-gradient(140deg, #FFC2D8, #F2689A); color: #fff; }
.wk.td { box-shadow: 0 0 0 3rpx var(--pink-deep); }

.cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.wd { text-align: center; font-size: 20rpx; font-weight: 700; color: var(--text-3); padding-bottom: 6rpx; }
.cal-day {
  aspect-ratio: 1; border-radius: 14rpx; background: var(--card-soft);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600; color: var(--text-2); gap: 3rpx;
}
.cal-day.out { opacity: 0.25; }
.cal-day.td { box-shadow: 0 0 0 3rpx var(--pink); font-weight: 800; color: var(--pink-deep); background: #fff; }
.cal-day.full { background: linear-gradient(140deg, #FFC2D8, #F2689A); color: #fff; }
.cal-day .mk { width: 7rpx; height: 7rpx; border-radius: 50%; background: #fff; }

.sw { width: 18rpx; height: 18rpx; border-radius: 5rpx; display: block; }
.sw-pink { background: linear-gradient(140deg, #FFC2D8, #F2689A); }
.sw-soft { background: var(--card-soft); }

/* 个人名片 */
.avatar-lg {
  width: 104rpx; height: 104rpx; border-radius: 32rpx; flex: none;
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
  background: linear-gradient(150deg, var(--accent-soft), #fff);
  border: 2rpx solid var(--line-2);
  box-shadow: 0 4rpx 16rpx rgba(242, 104, 154, 0.12);
}
.pname { font-size: 34rpx; font-weight: 800; color: var(--text-1); line-height: 1.3; }
.psign { font-size: 23rpx; color: var(--text-3); margin-top: 8rpx; line-height: 1.4; }

/* 全局搜索 */
.search-card { padding: 24rpx; }
.search-inp { flex: 1; }
.sr-list { margin-top: 18rpx; }
.sr-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 16rpx; border-radius: 18rpx; margin-bottom: 12rpx;
  background: var(--card-soft);
}
.sr-body { flex: 1; min-width: 0; }
.sr-t { font-size: 26rpx; font-weight: 700; color: var(--text-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sr-s { font-size: 21rpx; color: var(--text-3); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sr-empty { margin-top: 18rpx; text-align: center; font-size: 24rpx; color: var(--text-3); padding: 20rpx 0; }

/* 日历热力图：未打卡但有记录的日子按活跃度着色 */
.cal-day.lv1 { background: #FFF0F5; color: var(--pink-deep); }
.cal-day.lv2 { background: #FFE1EC; color: var(--pink-deep); }
.cal-day.lv3 { background: #FFCFE0; color: var(--pink-deep); }
.sw-lv1 { background: #FFF0F5; }
.sw-lv2 { background: #FFE1EC; }
.sw-lv3 { background: #FFCFE0; }
